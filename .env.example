# -----------------------------------------------------------------------------
# WriteX Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# NEVER commit your actual .env file to version control.
# -----------------------------------------------------------------------------

# AI Provider API Keys
# At least one key is required for document generation
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Database Configuration (SQLAlchemy 2.0)
# Default: Local SQLite database in WAL mode (zero-setup development & offline tests)
DATABASE_URL=sqlite:///./writex.db

# Supabase Production PostgreSQL (Optional - overrides SQLite when provided)
# For Supabase with Transaction Pooling (Port 6543 / Supavisor):
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Note: When port 6543 is used, server-side prepared statements are automatically disabled.

# Supabase Storage Configuration (Optional - for persisting generated .docx and uploaded archives)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET_REPORTS=writex-reports

# Job & Concurrency Settings
# Minutes before an unfinished job in non-terminal state is marked as FAILED upon server restart
STALE_JOB_TIMEOUT_MINUTES=10

# API Security
# Minimum bcrypt cost factor for API key hashing (default: 12)
BCRYPT_ROUNDS=12
